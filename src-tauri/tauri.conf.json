{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropCut",
  "version": "0.2.1",
  "identifier": "app.dropcut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DropCut",
        "width": 980,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/tools/": "tools/",
      "resources/licenses/": "licenses/",
      "resources/llm/": "llm/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMDhBRUU5MDQwMDA1NTEKUldSUkJRQUU2YTRJN05zTGVVWThNWEpEdWd5bEZ1ZUd4cTlBOWxQeHloN284WDJHS01yZm5SZksK",
      "endpoints": [
        "https://github.com/IK-Lv7/DropCut/releases/latest/download/latest.json"
      ]
    }
  }
}
